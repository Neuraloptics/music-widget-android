<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_music_note"
        android:label="Music Widget"
        android:theme="@android:style/Theme.DeviceDefault">

        <receiver
            android:name=".MusicWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.musicwidget.PLAY_PAUSE"/>
                <action android:name="com.musicwidget.NEXT"/>
                <action android:name="com.musicwidget.PREV"/>
                <action android:name="com.musicwidget.UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_info"/>
        </receiver>

        <service
            android:name=".MusicListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

    </application>

</manifest>
