<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para poder lanzar apps de musica en API 30+ -->
    <queries>
        <package android:name="com.spotify.music"/>
        <package android:name="com.google.android.apps.youtube.music"/>
        <package android:name="app.revanced.android.apps.youtube.music"/>
        <package android:name="com.vanced.android.apps.youtube.music"/>
        <package android:name="com.soundcloud.android"/>
        <package android:name="com.tidal.music"/>
        <package android:name="code.name.monkey.retromusic"/>
        <package android:name="com.maxmpz.audioplayer"/>
        <package android:name="org.videolan.vlc"/>
        <package android:name="com.dd3boh.outertune"/>
        <package android:name="app.opentune"/>
        <package android:name="com.opentune"/>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_music_note"
        android:label="Music Widget"
        android:theme="@android:style/Theme.DeviceDefault">

        <receiver
            android:name=".MusicWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.musicwidget.PLAY_PAUSE"/>
                <action android:name="com.musicwidget.NEXT"/>
                <action android:name="com.musicwidget.PREV"/>
                <action android:name="com.musicwidget.UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_info"/>
        </receiver>

        <service
            android:name=".MusicListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

    </application>

</manifest>
