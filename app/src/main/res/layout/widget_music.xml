<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp"
    android:baselineAligned="false">

    <!-- bloque superior: portada + texto + onda (se estira en alto) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/albumArt"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:maxHeight="110dp"
            android:minWidth="48dp"
            android:scaleType="fitCenter"
            android:background="@drawable/album_art_bg"
            android:src="@drawable/ic_music_note"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/songTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No music playing"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="15sp"/>

            <TextView
                android:id="@+id/artistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="11sp"/>

            <ProgressBar
                android:id="@+id/songProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="5dp"
                android:minHeight="12dp"
                android:maxHeight="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/wave_progress"/>

        </LinearLayout>

    </LinearLayout>

    <!-- controles abajo, distribuidos a lo ancho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/btnShuffle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_shuffle"
            android:scaleType="centerInside"
            android:padding="6dp"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_skip_previous"
            android:background="@drawable/btn_round_bg"
            android:scaleType="centerInside"
            android:padding="9dp"/>

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_play"
            android:background="@drawable/play_btn_bg"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"/>

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_skip_next"
            android:background="@drawable/btn_round_bg"
            android:scaleType="centerInside"
            android:padding="9dp"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btnRepeat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_repeat"
            android:scaleType="centerInside"
            android:padding="6dp"/>

    </LinearLayout>

</LinearLayout>
