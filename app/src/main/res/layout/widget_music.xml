<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical">

    <!-- portada cuadrada para que el redondeo no se recorte -->
    <ImageView
        android:id="@+id/albumArt"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:background="@drawable/album_art_bg"
        android:src="@drawable/ic_music_note"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No music playing"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/artistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- onda M3 Expressive -->
        <ImageView
            android:id="@+id/waveAccent"
            android:layout_width="46dp"
            android:layout_height="8dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/ic_wave"
            android:scaleType="fitXY"/>

        <!-- shuffle + progreso + repeat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <ImageView
                android:id="@+id/btnShuffle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_shuffle"
                android:background="@drawable/btn_round_bg"
                android:scaleType="centerInside"
                android:padding="7dp"/>

            <ProgressBar
                android:id="@+id/songProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:max="100"
                android:progress="0"/>

            <ImageView
                android:id="@+id/btnRepeat"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_repeat"
                android:background="@drawable/btn_round_bg"
                android:scaleType="centerInside"
                android:padding="7dp"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_skip_previous"
            android:background="@drawable/btn_round_bg"
            android:scaleType="centerInside"
            android:padding="9dp"/>

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_play"
            android:background="@drawable/play_btn_bg"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_skip_next"
            android:background="@drawable/btn_round_bg"
            android:scaleType="centerInside"
            android:padding="9dp"/>

    </LinearLayout>

</LinearLayout>
