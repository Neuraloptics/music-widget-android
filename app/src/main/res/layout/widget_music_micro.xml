<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- texto + iconos -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No music playing"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="11sp"/>

        <TextView
            android:id="@+id/artistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="8sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="9sp"/>

        <TextView
            android:id="@+id/albumName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#99FFFFFF"
            android:textSize="8sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="9sp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnShuffle"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shuffle"
                android:background="@drawable/ripple_cell_sm"
                android:scaleType="centerInside"
                android:padding="3dp"/>

            <ImageView
                android:id="@+id/btnRepeat"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_repeat"
                android:background="@drawable/ripple_cell_sm"
                android:scaleType="centerInside"
                android:padding="3dp"/>

            <ImageView
                android:id="@+id/btnLike"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_heart_outline"
                android:background="@drawable/ripple_cell_sm"
                android:scaleType="centerInside"
                android:padding="3dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- dock -->
    <LinearLayout
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:background="@drawable/dock_bg"
        android:orientation="vertical"
        android:padding="2dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="38dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_skip_previous"
            android:background="@drawable/ripple_cell"
            android:scaleType="centerInside"
            android:padding="6dp"/>

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ic_play"
            android:background="@drawable/play_pill"
            android:scaleType="centerInside"
            android:padding="8dp"/>

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="38dp"
            android:layout_height="26dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ic_skip_next"
            android:background="@drawable/ripple_cell"
            android:scaleType="centerInside"
            android:padding="6dp"/>

    </LinearLayout>

</LinearLayout>
